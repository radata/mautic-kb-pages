{% extends '@MauticKbPages/Public/base.html.twig' %}

{% block pageTitle %}Knowledge Base{% endblock %}

{% block kbBody %}
    <h1>Knowledge Base</h1>
    <p>Browse grouped support articles.</p>

    {% if groups %}
        {% for group in groups %}
            <div class="kb-card">
                <h2 class="kb-title">
                    {% if group.iconHtml %}
                        <span class="kb-icon">{{ group.iconHtml|raw }}</span>
                    {% endif %}
                    <a href="{{ path('mautic_knowledgebase_group', {slug: group.entity.getSlug()}) }}">{{ group.entity.getTitle() }}</a>
                </h2>
                {% if group.entity.getSummary() %}
                    <p>{{ group.entity.getSummary()|striptags }}</p>
                {% endif %}
            </div>
        {% endfor %}
    {% else %}
        <div class="kb-card">
            <p>No knowledge base groups are published yet.</p>
        </div>
    {% endif %}
{% endblock %}
