{% extends '@MauticKbPages/Public/base.html.twig' %}

{% block pageTitle %}{{ article.getTitle() }}{% endblock %}

{% block kbBody %}
    {% if group %}
        <p class="kb-breadcrumb">
            <a href="{{ path('mautic_knowledgebase_group', {slug: group.getSlug()}) }}">{{ group.getTitle() }}</a>
        </p>
    {% endif %}

    <div class="kb-card">
        <h1>{{ article.getTitle() }}</h1>
        {% if article.getSummary() %}
            <p>{{ article.getSummary()|striptags }}</p>
        {% endif %}
        {% if article.getContent() %}
            <div>{{ article.getContent()|raw }}</div>
        {% endif %}
    </div>
{% endblock %}
