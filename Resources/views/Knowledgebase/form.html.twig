{% extends '@MauticCore/Default/content.html.twig' %}

{% set header = entity.getId()
    ? 'mautic.kbpages.edit'|trans({'%title%': entity.getTitle()})
    : 'mautic.kbpages.new'|trans %}

{% block headerTitle %}{{ header }}{% endblock %}
{% block mauticContent %}{{ mauticContent }}{% endblock %}

{% block content %}
    {{ form_start(form) }}

    <style>
        #kb-editor-width-preview {
            max-width: {{ editorPreviewWidth|default(960) }}px;
            transition: max-width 0.15s ease;
        }
    </style>

    <div class="box-layout">
        <div class="col-md-9 height-auto bdr-r">
            <div class="pa-md">
                <div class="alert alert-info">
                    {{ 'plugin.kbpages.form.help'|trans }}
                </div>

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.title) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.slug) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.type) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.parent) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(form.icon) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.position) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.isPublished) }}
                    </div>
                </div>

                <div id="kb-editor-width-preview" data-default-width="{{ editorPreviewWidth|default(960) }}">
                    <div class="row">
                        <div class="col-xs-12">
                            {{ form_row(form.summary) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xs-12">
                            {{ form_row(form.content) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xs-12">
                            {{ form_row(form.contentUseRaw) }}
                        </div>
                    </div>

                    <div id="kb-content-raw-panel" class="row">
                        <div class="col-xs-12">
                            {{ form_row(form.contentRaw) }}
                        </div>
                    </div>

                    <div id="kb-root-settings-panel" class="panel panel-default mt-lg">
                        <div class="panel-heading">
                            <h4 class="panel-title">{{ 'plugin.kbpages.root_shell.title'|trans }}</h4>
                        </div>
                        <div class="panel-body">
                            <p class="text-muted">{{ 'plugin.kbpages.root_shell.help'|trans }}</p>

                            {% if snippetsPreviewUrl|default(null) %}
                                <p class="small">
                                    <a href="{{ snippetsPreviewUrl }}" target="_blank" rel="noopener noreferrer">
                                        {{ 'plugin.kbpages.root_snippets_preview'|trans }}
                                    </a>
                                </p>
                            {% endif %}

                            <div class="row">
                                <div class="col-xs-12">
                                    {{ form_row(form.headerHtml) }}
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-12">
                                    {{ form_row(form.headerHtmlUseRaw) }}
                                </div>
                            </div>

                            <div id="kb-header-raw-panel" class="row">
                                <div class="col-xs-12">
                                    {{ form_row(form.headerHtmlRaw) }}
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-12">
                                    {{ form_row(form.footerHtml) }}
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-12">
                                    {{ form_row(form.footerHtmlUseRaw) }}
                                </div>
                            </div>

                            <div id="kb-footer-raw-panel" class="row">
                                <div class="col-xs-12">
                                    {{ form_row(form.footerHtmlRaw) }}
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    {{ form_row(form.containerWidth) }}
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-12">
                                    {{ form_row(form.customCss) }}
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-12">
                                    {{ form_row(form.snippetsHtml) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pa-md">
        {{ form_row(form.buttons) }}
    </div>

    {{ form_end(form) }}

    <script>
        (function () {
            var typeField = document.getElementById('knowledgebase_item_type');
            var parentField = document.getElementById('knowledgebase_item_parent');
            var panel = document.getElementById('kb-root-settings-panel');
            var contentField = document.getElementById('knowledgebase_item_content');
            var contentUseRawField = document.getElementById('knowledgebase_item_contentUseRaw');
            var contentRawField = document.getElementById('knowledgebase_item_contentRaw');
            var contentRawPanel = document.getElementById('kb-content-raw-panel');
            var headerField = document.getElementById('knowledgebase_item_headerHtml');
            var headerUseRawField = document.getElementById('knowledgebase_item_headerHtmlUseRaw');
            var headerRawField = document.getElementById('knowledgebase_item_headerHtmlRaw');
            var headerRawPanel = document.getElementById('kb-header-raw-panel');
            var footerField = document.getElementById('knowledgebase_item_footerHtml');
            var footerUseRawField = document.getElementById('knowledgebase_item_footerHtmlUseRaw');
            var footerRawField = document.getElementById('knowledgebase_item_footerHtmlRaw');
            var footerRawPanel = document.getElementById('kb-footer-raw-panel');
            var widthField = document.getElementById('knowledgebase_item_containerWidth');
            var editorWidthPreview = document.getElementById('kb-editor-width-preview');

            if (!typeField || !parentField || !panel) {
                return;
            }

            function toggleRootSettings() {
                var isRootGroup = typeField.value === 'group' && !parentField.value;
                panel.style.display = isRootGroup ? '' : 'none';
            }

            function resolvePreviewWidth() {
                if (!editorWidthPreview) {
                    return 960;
                }

                var defaultWidth = parseInt(editorWidthPreview.getAttribute('data-default-width') || '960', 10);
                if (isNaN(defaultWidth) || defaultWidth < 480) {
                    defaultWidth = 960;
                }

                var isRootGroup = typeField.value === 'group' && !parentField.value;
                if (isRootGroup && widthField) {
                    var rootWidth = parseInt(widthField.value || '', 10);
                    if (!isNaN(rootWidth) && rootWidth >= 480) {
                        return rootWidth;
                    }
                }

                if (parentField && parentField.selectedIndex > 0) {
                    var selectedOption = parentField.options[parentField.selectedIndex];
                    var parentWidth = parseInt(selectedOption.getAttribute('data-root-width') || '', 10);
                    if (!isNaN(parentWidth) && parentWidth >= 480) {
                        return parentWidth;
                    }
                }

                return defaultWidth;
            }

            function updatePreviewWidth() {
                if (!editorWidthPreview) {
                    return;
                }

                editorWidthPreview.style.maxWidth = resolvePreviewWidth() + 'px';
            }

            function getEditorInstance(textarea) {
                if (!textarea || !window.ckEditors || typeof window.ckEditors.has !== 'function') {
                    return null;
                }

                return window.ckEditors.has(textarea) ? window.ckEditors.get(textarea) : null;
            }

            function syncEditorToTextarea(textarea) {
                var editor = getEditorInstance(textarea);
                if (editor && typeof editor.updateSourceElement === 'function') {
                    editor.updateSourceElement();
                }
            }

            function syncRawToggle(toggleField, editorField, rawField, rawPanel) {
                if (!toggleField || !editorField || !rawField || !rawPanel) {
                    return;
                }

                if (toggleField.checked) {
                    syncEditorToTextarea(editorField);
                    rawField.value = editorField.value;
                    rawPanel.style.display = '';
                } else {
                    editorField.value = rawField.value;

                    var editor = getEditorInstance(editorField);
                    if (editor && typeof editor.setData === 'function') {
                        editor.setData(rawField.value || '');
                    }

                    rawPanel.style.display = 'none';
                }
            }

            typeField.addEventListener('change', toggleRootSettings);
            parentField.addEventListener('change', toggleRootSettings);
            typeField.addEventListener('change', updatePreviewWidth);
            parentField.addEventListener('change', updatePreviewWidth);

            if (widthField) {
                widthField.addEventListener('input', updatePreviewWidth);
                widthField.addEventListener('change', updatePreviewWidth);
            }

            if (contentUseRawField) {
                contentUseRawField.addEventListener('change', function () {
                    syncRawToggle(contentUseRawField, contentField, contentRawField, contentRawPanel);
                });
            }

            if (headerUseRawField) {
                headerUseRawField.addEventListener('change', function () {
                    syncRawToggle(headerUseRawField, headerField, headerRawField, headerRawPanel);
                });
            }

            if (footerUseRawField) {
                footerUseRawField.addEventListener('change', function () {
                    syncRawToggle(footerUseRawField, footerField, footerRawField, footerRawPanel);
                });
            }

            toggleRootSettings();
            updatePreviewWidth();
            syncRawToggle(contentUseRawField, contentField, contentRawField, contentRawPanel);
            syncRawToggle(headerUseRawField, headerField, headerRawField, headerRawPanel);
            syncRawToggle(footerUseRawField, footerField, footerRawField, footerRawPanel);
        })();
    </script>
{% endblock %}
