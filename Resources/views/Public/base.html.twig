<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en')|replace({'_': '-'}) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block pageTitle %}Knowledge Base{% endblock %}</title>
    {% if kbSettings.tablerCssUrl %}
        <link rel="stylesheet" href="{{ kbSettings.tablerCssUrl }}">
    {% endif %}
    <style>
        :root {
            color-scheme: light dark;
            --kb-shell-width: {{ kbSettings.containerWidth|default(960) }}px;
            --kb-shell-bg: #f5f7fb;
            --kb-panel-bg: #ffffff;
            --kb-panel-border: #e5e7eb;
            --kb-text: #1f2937;
            --kb-text-soft: #4b5563;
            --kb-link: #2563eb;
            --kb-icon-box-bg: #ffffff;
            --kb-icon-box-border: rgba(37, 99, 235, 0.08);
            --kb-icon-box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08);
            --kb-icon-color: #2563eb;
            --kb-table-bg: #ffffff;
            --kb-table-head-bg: #f8fafc;
            --kb-code-bg: rgba(37, 99, 235, 0.08);
            --kb-code-border: rgba(148, 163, 184, 0.35);
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --kb-shell-bg: #0b1220;
                --kb-panel-bg: #0f172a;
                --kb-panel-border: #243244;
                --kb-text: #e5edf7;
                --kb-text-soft: #b6c2d2;
                --kb-link: #7cb5ff;
                --kb-icon-box-bg: #101a2d;
                --kb-icon-box-border: rgba(124, 181, 255, 0.18);
                --kb-icon-box-shadow: 0 12px 28px rgba(2, 6, 23, 0.35);
                --kb-icon-color: #8ec5ff;
                --kb-table-bg: #0f172a;
                --kb-table-head-bg: #162133;
                --kb-code-bg: rgba(148, 163, 184, 0.14);
                --kb-code-border: rgba(148, 163, 184, 0.28);
            }
        }

        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: sans-serif;
            background: var(--kb-shell-bg);
            color: var(--kb-text);
        }
        a { color: var(--kb-link); text-decoration: none; }
        a:hover { text-decoration: underline; }
        p { color: var(--kb-text-soft); }
        .kb-shell {
            width: min(100%, var(--kb-shell-width));
            margin: 0 auto;
            padding: 32px 20px 56px;
        }
        .kb-rich {
            width: min(100%, var(--kb-shell-width));
            margin: 0 auto;
            padding: 24px 20px 0;
        }
        .kb-card {
            background: var(--kb-panel-bg);
            border: 1px solid var(--kb-panel-border);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 16px;
        }
        .kb-list {
            margin: 16px 0 0;
            padding-left: 0;
            list-style: none;
        }
        .kb-list li + li {
            margin-top: 12px;
        }
        .kb-breadcrumb {
            margin: 0 0 20px;
        }
        .kb-title {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .kb-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            width: 54px;
            height: 54px;
            padding: 12px;
            border-radius: 16px;
            border: 1px solid var(--kb-icon-box-border);
            background: var(--kb-icon-box-bg);
            box-shadow: var(--kb-icon-box-shadow);
            color: var(--kb-icon-color);
        }
        .kb-icon i {
            font-size: 28px;
            line-height: 1;
        }
        .kb-icon img,
        .kb-icon svg {
            display: block;
            width: 28px;
            height: 28px;
            object-fit: contain;
        }
        .kb-list-link {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            min-height: 54px;
        }
        .kb-card figure.table,
        .kb-rich figure.table {
            margin: 16px 0;
            overflow-x: auto;
        }
        .kb-card table,
        .kb-rich table {
            width: 100%;
            border-collapse: collapse;
            background: var(--kb-table-bg);
        }
        .kb-card th,
        .kb-card td,
        .kb-rich th,
        .kb-rich td {
            min-width: 96px;
            padding: 10px 12px;
            border: 1px solid var(--kb-panel-border);
            vertical-align: top;
        }
        .kb-card thead th,
        .kb-rich thead th {
            background: var(--kb-table-head-bg);
            color: var(--kb-text);
            font-weight: 600;
        }
        .kb-card code,
        .kb-rich code {
            padding: 0.16rem 0.34rem;
            border: 1px solid var(--kb-code-border);
            border-radius: 7px;
            background: var(--kb-code-bg);
        }
    </style>
    {% if kbSettings.customCss %}
        <style>{{ kbSettings.customCss|raw }}</style>
    {% endif %}
</head>
<body>
{% if kbSettings.headerHtml %}
    <div class="kb-rich kb-header">
        {{ kbSettings.headerHtml|raw }}
    </div>
{% endif %}

<main class="kb-shell">
    {% block kbBody %}{% endblock %}
</main>

{% if kbSettings.footerHtml %}
    <div class="kb-rich kb-footer">
        {{ kbSettings.footerHtml|raw }}
    </div>
{% endif %}
</body>
</html>
