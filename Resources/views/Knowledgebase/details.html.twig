{% extends '@MauticCore/Default/content.html.twig' %}

{% set pathSlugs = item.getPathSlugs() %}
{% set previewUrl = previewUrl|default(null) %}
{% if not previewUrl %}
    {% if pathSlugs|length == 1 %}
        {% set previewUrl = url('mautic_knowledgebase_group', {slug: pathSlugs|first}) %}
    {% elseif pathSlugs|length > 1 %}
        {% set previewUrl = url('mautic_knowledgebase_tree', {
            rootSlug: pathSlugs|first,
            slugPath: pathSlugs|slice(1)|join('/'),
        }) %}
    {% endif %}
{% endif %}

{% block mauticContent %}{{ mauticContent }}{% endblock %}
{% block headerTitle %}{{ item.getTitle() }}{% endblock %}

{% block preHeader %}
    {{ include('@MauticCore/Helper/page_actions.html.twig', {
        item: item,
        routeBase: 'knowledgebase',
        actionRoute: actionRoute,
        indexRoute: indexRoute,
        langVar: 'kbpages',
        nameGetter: 'getTitle',
        targetLabel: 'mautic.kbpages.title'|trans,
        templateButtons: {
            close: permissions[permissionBase ~ ':view'] or permissions[permissionBase ~ ':viewown'] or permissions[permissionBase ~ ':viewother'],
        },
    }) }}
{% endblock %}

{% block actions %}
    {{ include('@MauticCore/Helper/page_actions.html.twig', {
        item: item,
        routeBase: 'knowledgebase',
        actionRoute: actionRoute,
        indexRoute: indexRoute,
        langVar: 'kbpages',
        nameGetter: 'getTitle',
        customButtons: previewUrl ? [{
            attr: {
                class: 'btn btn-tertiary btn-nospin',
                href: previewUrl,
                target: '_blank',
                rel: 'noopener noreferrer',
                'data-toggle': '',
            },
            iconClass: 'ri-external-link-line',
            btnText: 'mautic.core.open_link'|trans,
            primary: true,
            priority: 250,
        }] : [],
        templateButtons: {
            edit: securityHasEntityAccess(
                permissions[permissionBase ~ ':editown'],
                permissions[permissionBase ~ ':editother'],
                item.getCreatedBy()
            ),
            clone: permissions[permissionBase ~ ':create'],
            delete: securityHasEntityAccess(
                permissions[permissionBase ~ ':deleteown'],
                permissions[permissionBase ~ ':deleteother'],
                item.getCreatedBy()
            ),
        },
    }) }}
{% endblock %}

{% block content %}
    <div class="box-layout">
        <div class="col-md-9 height-auto bdr-r">
            <div class="pa-md">
                <div class="row mb-md">
                    <div class="col-md-3"><strong>{{ 'plugin.kbpages.type'|trans }}</strong></div>
                    <div class="col-md-9">
                        {% include '@MauticCore/Helper/_tag.html.twig' with {
                            tags: [{
                                label: (item.isGroup() ? 'plugin.kbpages.type.group' : 'plugin.kbpages.type.article')|trans,
                                color: item.isGroup() ? 'green' : 'warm-gray'
                            }]
                        } %}
                    </div>
                </div>

                <div class="row mb-md">
                    <div class="col-md-3"><strong>{{ 'plugin.kbpages.path'|trans }}</strong></div>
                    <div class="col-md-9"><code>/{{ pathSlugs|join('/') }}</code></div>
                </div>

                {% if previewUrl %}
                    <div class="row mb-md">
                        <div class="col-md-3"><strong>{{ 'plugin.kbpages.public_url'|trans }}</strong></div>
                        <div class="col-md-9">
                            <a href="{{ previewUrl }}" target="_blank" rel="noopener noreferrer">{{ previewUrl }}</a>
                        </div>
                    </div>
                {% endif %}

                <div class="row mb-md">
                    <div class="col-md-3"><strong>{{ 'plugin.kbpages.group'|trans }}</strong></div>
                    <div class="col-md-9">
                        {% if item.getParent() %}
                            {{ item.getParent().getTitle() }}
                            <br>
                            <code>/{{ item.getParent().getPathSlugs()|join('/') }}</code>
                        {% else %}
                            {{ 'plugin.kbpages.empty'|trans }}
                        {% endif %}
                    </div>
                </div>

                <div class="row mb-md">
                    <div class="col-md-3"><strong>{{ 'plugin.kbpages.icon'|trans }}</strong></div>
                    <div class="col-md-9">{{ item.getIcon() ?: 'plugin.kbpages.empty'|trans }}</div>
                </div>

                <div class="row mb-md">
                    <div class="col-md-3"><strong>{{ 'plugin.kbpages.position'|trans }}</strong></div>
                    <div class="col-md-9">{{ item.getPosition() }}</div>
                </div>

                {% if item.getSummary() %}
                    <hr>
                    <h4>{{ 'plugin.kbpages.summary'|trans }}</h4>
                    <p>{{ item.getSummary()|striptags|nl2br }}</p>
                {% endif %}

                <hr>
                <h4>{{ 'plugin.kbpages.content'|trans }}</h4>
                <div class="panel panel-default">
                    <div class="panel-body">
                        {% if item.getContent() %}
                            {{ item.getContent()|raw }}
                        {% else %}
                            <p class="mb-0">{{ 'plugin.kbpages.article.empty'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
