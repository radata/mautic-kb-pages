{% extends '@MauticKbPages/Public/base.html.twig' %}

{% block pageTitle %}{{ group.getTitle() }}{% endblock %}

{% block kbBody %}
    <div class="kb-card">
        <h1>{{ group.getTitle() }}</h1>
        {% if group.getSummary() %}
            <p>{{ group.getSummary()|striptags }}</p>
        {% endif %}
        {% if group.getContent() %}
            <div>{{ group.getContent()|raw }}</div>
        {% endif %}
    </div>

    <div class="kb-card">
        <h2>Articles</h2>
        {% if articles %}
            <ul class="kb-list">
                {% for article in articles %}
                    <li>
                        <a href="{{ path('mautic_knowledgebase_article', {
                            groupSlug: group.getSlug(),
                            slug: article.getSlug()
                        }) }}">{{ article.getTitle() }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>No articles are published in this group yet.</p>
        {% endif %}
    </div>
{% endblock %}
