{% extends '@MauticKbPages/Public/base.html.twig' %}

{% block pageTitle %}{{ article.getTitle() }}{% endblock %}

{% block kbBody %}
    {% if group and groupUrl %}
        <p class="kb-breadcrumb">
            <a href="{{ groupUrl }}">{{ group.getTitle() }}</a>
        </p>
    {% endif %}

    <div class="kb-card">
        <h1 class="kb-title">
            {% if articleIconHtml %}
                <span class="kb-icon">{{ articleIconHtml|raw }}</span>
            {% endif %}
            <span>{{ article.getTitle() }}</span>
        </h1>
        {% if article.getSummary() %}
            <p>{{ article.getSummary()|striptags }}</p>
        {% endif %}
        {% if articleContent is not empty %}
            <div>{{ articleContent|raw }}</div>
        {% endif %}
    </div>
{% endblock %}
